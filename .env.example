# AgroGuide AI - Environment Configuration Example

# Server Environment Variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase Credentials (Required for cloud database & auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI SDK Configuration (Official @google/genai)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Weather Integration (OpenWeatherMap / WeatherAPI)
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Security & Upload Configuration
MAX_UPLOAD_SIZE_MB=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
JWT_AUDIENCE=authenticated
LOG_LEVEL=info

# Client Environment Variables (Exposed to browser via Vite)
# VITE_API_BASE_URL=http://localhost:5000/api/v1
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
